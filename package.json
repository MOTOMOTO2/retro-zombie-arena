{
  "name": "retro-zombie-arena",
  "version": "1.0.0",
  "private": true,
  "description": "RETRO ZOMBIE ARENA - an arcade wave-survival FPS with early-3D-era graphics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:browser": "node test/browser-smoke.mjs",
    "map": "node tools/mapcheck.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
